; Radeberg – Godot 4 Projekt
config_version=5

[application]
run/max_fps=60
config/name="Radeberg"
config/description="Open-World-Spiel in Radeberg"
config/version="0.1"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.05,0.05,0.06,1)
run/main_scene="res://scenes/spiel.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
textures/default_filters/anisotropic_filtering_level=3
scaling_3d/mode=1
scaling_3d/scale=0.85
environment/ssao/quality=1
environment/ssil/quality=0
environment/screen_space_reflection/roughness_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
mesh_lod/lod_change/threshold_pixels=1.0
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.6,0.7,0.8,1)

[input_devices]
pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3
